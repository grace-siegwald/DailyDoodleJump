<Project>

  <!-- Shared settings for every project under this folder (src/ and tests/). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Project info -->
    <Authors>Daily Doodle Jump Team</Authors>
    <RepositoryUrl>https://github.com/grace-siegwald/DailyDoodleJump</RepositoryUrl>
  </PropertyGroup>

</Project>
