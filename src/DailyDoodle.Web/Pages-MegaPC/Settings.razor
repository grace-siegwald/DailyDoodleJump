@page "/settings"

<PageTitle>Profile &amp; Settings</PageTitle>

<h1 class="visually-hidden">Profile &amp; Settings</h1>

<section class="card profile-card" aria-label="Profile">
    <div class="avatar" aria-hidden="true">
        <svg viewBox="0 0 64 64">
            <circle cx="32" cy="24" r="11" />
            <path d="M12 54c0-11 9-18 20-18s20 7 20 18z" />
        </svg>
    </div>
    <div class="profile-text">
        <div class="name">Player</div>
        <div class="handle">Playing on this device</div>
    </div>
</section>

<h2 class="section-label">Account</h2>
<div class="card group">
    <SettingRow Title="Account" Description="Sign-in isn't available yet.">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
        </Icon>
    </SettingRow>
</div>

<h2 class="section-label">Preferences</h2>
<div class="card group">
    <SettingRow Title="Notifications" Value="Not available yet">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
        </Icon>
    </SettingRow>
    <SettingRow Title="Appearance" Value="Light">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
        </Icon>
    </SettingRow>
    <SettingRow Title="Sound &amp; Haptics" Value="Not available yet">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
        </Icon>
    </SettingRow>
    <SettingRow Title="Privacy" Value="Not available yet">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
        </Icon>
    </SettingRow>
</div>
