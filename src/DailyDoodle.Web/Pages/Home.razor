@page "/"
@implements IAsyncDisposable
@using DailyDoodle.Core
@inject GameSession Session
@inject IJSRuntime JS

<PageTitle>@Session.CurrentGame.Title</PageTitle>

<h1 class="visually-hidden">@Session.CurrentGame.Title</h1>

<section class="card game-card" aria-label="Game">
    <div class="stats">
        <div class="stat">
            <span class="stat-label">Score</span>
            <span class="stat-value" aria-label="Score not available yet">&mdash;</span>
        </div>
        <div class="stat stat-end">
            <span class="stat-label">Level</span>
            <span class="stat-value" aria-label="Level not available yet">&mdash;</span>
        </div>
    </div>

    @*
        The game's window. wwwroot/js/game-loop.js puts the canvas KNI draws into in here,
        in the shape of the 400x640 play area, and keeps that canvas when you leave the page.
    *@
    <div id="canvasHolder" class="game-window" role="img"
         aria-label="@($"{LevelName}, {_levelDateText}")"></div>

    <p class="caption">@LevelName &middot; @_levelDateText</p>
</section>

@if (_problem is not null)
{
    <p class="notice" role="status">@_problem</p>
}

<GameControls Enabled="false"
              DisabledReason="Controls turn on once gameplay is built. For now: arrow keys or A and D." />

@code {
    // Which day's level to play, from a calendar link like ?date=2026-11-03. No date means today.
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    private DateOnly _today;
    private DateOnly _levelDate;
    private string _levelDateText = "";

    // Why the link's date wasn't used (unreadable, or a day that hasn't happened yet). Null when it was.
    private string? _problem;

    private string LevelName => _levelDate == _today ? "Today's level" : "Past level";

    // KNI can only start one game per page load, so the game outlives this page:
    // leaving Home stops the frame loop, coming back starts it again.
    private static DailyDoodleGame? _game;

    private DotNetObjectReference<Home>? _self;

    // Runs on first load and again whenever the link's date changes while you're on this page.
    protected override void OnParametersSet()
    {
        // UTC date, matching DailySeed, so the label and the level always agree.
        _today = LevelDate.Today;
        (_levelDate, _problem) = LevelDate.Choose(DateText, _today);
        _levelDateText = _levelDate.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);

        // The game outlives this page, so it may still be on another day's level.
        if (_game is not null && _game.LevelDate != _levelDate)
        {
            _game.StartLevel(_levelDate);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The holder exists only after the first render. Start the browser's frame loop (wwwroot/js/game-loop.js).
        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("initRenderJS", _self, DailyDoodleGame.VirtualWidth, DailyDoodleGame.VirtualHeight);
    }

    // Called by game-loop.js once per browser frame, with where the canvas is on the page (CSS pixels).
    [JSInvokable]
    public void TickDotNet(float canvasLeft, float canvasTop, float canvasWidth)
    {
        if (_game is null)
        {
            _game = new DailyDoodleGame(_levelDate);
            _game.Run();
        }

        _game.SetCanvasPlacement(canvasLeft, canvasTop, canvasWidth);
        _game.Tick();
    }

    public async ValueTask DisposeAsync()
    {
        // Leaving the page takes the canvas off the page, so stop the frame loop.
        // The game itself is kept, with its WebGL context, for when you come back.
        await JS.InvokeVoidAsync("stopRenderJS");
        _self?.Dispose();
    }
}
