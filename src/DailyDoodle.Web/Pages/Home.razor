@page "/"
@implements IAsyncDisposable
@using DailyDoodle.Core
@inject GameSession Session
@inject ProgressStore Store
@inject IJSRuntime JS

<PageTitle>@Session.CurrentGame.Title</PageTitle>

<h1 class="visually-hidden">@Session.CurrentGame.Title</h1>

<section class="card game-card" aria-label="Game">
    <div class="stats">
        <div class="stat">
            <span class="stat-label">Score</span>
            <span class="stat-value" aria-label="Score not available yet">&mdash;</span>
        </div>
        <div class="stat stat-end">
            <span class="stat-label">@HighestLabel</span>
            <span class="stat-value">@DisplayHeight.Format(_shownBest)</span>
        </div>
    </div>

    @*
        The game's window. wwwroot/js/game-loop.js puts the canvas KNI draws into in here,
        in the shape of the 400x640 play area, and keeps that canvas when you leave the page.
    *@
    <div class="game-stage">
        <div id="canvasHolder" class="game-window" role="img"
             aria-label="@($"{LevelName}, {_levelDateText}")"></div>

        @if (_shownState == RunState.Won)
        {
            <div class="end-screen" role="dialog" aria-labelledby="end-title" aria-describedby="end-message">
                <p class="end-kicker">@LevelName cleared</p>
                <h2 id="end-title" class="end-title">You made it to the top!</h2>

                @if (_levelDate == _today)
                {
                    <p id="end-message" class="end-message">Come back tomorrow for a new level, or catch up on a day you missed.</p>
                    @if (_streak > 0)
                    {
                        <p class="streak">@(_streak == 1 ? "1 day" : $"{_streak} days") in a row</p>
                    }
                }
                else
                {
                    <p id="end-message" class="end-message">@_levelDate.ToString("MMMM d", System.Globalization.CultureInfo.InvariantCulture) is done. Try another day, or come back tomorrow for a new level.</p>
                }

                <div class="end-actions">
                    <a class="end-button primary" href="calendar" @ref="_endScreenFirstButton">Play a past level</a>
                    <button type="button" class="end-button" @onclick="ClimbAgain">Climb again</button>
                </div>
            </div>
        }
    </div>

    <p class="caption">@LevelName &middot; @_levelDateText</p>
</section>

@if (_problem is not null)
{
    <p class="notice" role="status">@_problem</p>
}

<GameControls Enabled="false"
              DisabledReason="Controls turn on once gameplay is built. For now: arrow keys or A and D." />

@code {
    // Which day's level to play, from a calendar link like ?date=2026-11-03. No date means today.
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateText { get; set; }

    private DateOnly _today;
    private DateOnly _levelDate;
    private string _levelDateText = "";

    // Why the link's date wasn't used (unreadable, or a day that hasn't happened yet). Null when it was.
    private string? _problem;

    private string LevelName => _levelDate == _today ? "Today's level" : "Past level";

    // KNI can only start one game per page load, so the game outlives this page:
    // leaving Home stops the frame loop, coming back starts it again.
    private static DailyDoodleGame? _game;

    // The last run whose result was saved. Static, like the game, so leaving and coming back
    // doesn't save the same run twice.
    private static int _savedRun;

    private DotNetObjectReference<Home>? _self;

    // What the page last showed, so it only re-renders when something visible changes.
    private RunState _shownState = RunState.Playing;
    private int _streak;

    // Best height on this level today: the saved best, or the current run once it climbs past that.
    private float _shownBest;

    private string HighestLabel => _levelDate == _today
        ? "Highest Today"
        : $"Highest {_levelDate.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)}";

    private ElementReference _endScreenFirstButton;
    private bool _focusEndScreen;

    // Runs on first load and again whenever the link's date changes while you're on this page.
    protected override void OnParametersSet()
    {
        // UTC date, matching DailySeed, so the label and the level always agree.
        _today = LevelDate.Today;
        (_levelDate, _problem) = LevelDate.Choose(DateText, _today);
        _levelDateText = _levelDate.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);

        // The game outlives this page, so it may still be on another day's level.
        if (_game is not null && _game.LevelDate != _levelDate)
        {
            SaveUnfinishedRun();
            _game.StartLevel(_levelDate);
        }

        _shownState = _game?.State ?? RunState.Playing;
        _streak = Store.Progress.CurrentStreak(_today);
        _shownBest = BestSoFar();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusEndScreen)
        {
            // Move keyboard focus onto the win screen's first button as it appears.
            _focusEndScreen = false;
            await _endScreenFirstButton.FocusAsync();
        }

        if (!firstRender)
        {
            return;
        }

        // The holder exists only after the first render. Start the browser's frame loop (wwwroot/js/game-loop.js).
        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("initRenderJS", _self, DailyDoodleGame.VirtualWidth, DailyDoodleGame.VirtualHeight);
    }

    // Called by game-loop.js once per browser frame, with where the canvas is on the page (CSS pixels).
    [JSInvokable]
    public void TickDotNet(float canvasLeft, float canvasTop, float canvasWidth)
    {
        if (_game is null)
        {
            _game = new DailyDoodleGame(_levelDate);
            _game.Run();
        }

        _game.SetCanvasPlacement(canvasLeft, canvasTop, canvasWidth);
        _game.Tick();

        SaveFinishedRun();

        // Re-render only when something on screen changes, not every frame.
        var state = _game.State;
        var best = BestSoFar();
        if (state != _shownState || DisplayHeight.From(best) != DisplayHeight.From(_shownBest))
        {
            _focusEndScreen = state == RunState.Won && _shownState != RunState.Won;
            _shownState = state;
            _shownBest = best;
            StateHasChanged();
        }
    }

    private float BestSoFar()
    {
        var saved = Store.Progress[_levelDate].BestHeight;
        return _game is not null && _game.LevelDate == _levelDate ? Math.Max(saved, _game.HeightClimbed) : saved;
    }

    // Saves a run once it has ended, won or lost. Each run is saved once.
    private void SaveFinishedRun()
    {
        if (_game is null || _game.State == RunState.Playing || _savedRun == _game.RunNumber)
        {
            return;
        }

        _savedRun = _game.RunNumber;
        Store.RecordRun(_game.LevelDate, _game.HeightClimbed, finished: _game.State == RunState.Won);
        _streak = Store.Progress.CurrentStreak(_today);
    }

    // Before a run is thrown away part-way (switching levels), keep how high it got.
    private void SaveUnfinishedRun()
    {
        if (_game is null || _game.State != RunState.Playing || _savedRun == _game.RunNumber || _game.HeightClimbed <= 0f)
        {
            return;
        }

        _savedRun = _game.RunNumber;
        Store.RecordRun(_game.LevelDate, _game.HeightClimbed, finished: false);
    }

    private void ClimbAgain()
    {
        _game?.Restart();
        _shownState = RunState.Playing;
    }

    public async ValueTask DisposeAsync()
    {
        // Leaving the page takes the canvas off the page, so stop the frame loop.
        // The game itself is kept, with its WebGL context, for when you come back.
        await JS.InvokeVoidAsync("stopRenderJS");
        _self?.Dispose();
    }
}
