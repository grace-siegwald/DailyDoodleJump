@page "/calendar"
@using System.Globalization
@implements IDisposable
@inject NavigationManager Navigation
@inject ProgressStore Store

<PageTitle>Calendar</PageTitle>

<h1 class="page-title">Calendar</h1>
<p class="subtitle">Play today's level, or go back to a day you missed.</p>

<section class="card daily-card" aria-label="Daily game">
    <div class="daily-top">
        <span class="daily-title">Daily game</span>
        <span class="daily-date">@_today.ToString("MMM d", CultureInfo.InvariantCulture)</span>
        <a class="play-button" href="">@(_todayDone ? "Done" : "Play")</a>
    </div>

    @if (_streak > 0)
    {
        <p class="streak-line">@(_streak == 1 ? "1 day" : $"{_streak} days") in a row</p>
    }

    <WeekStrip Today="_today" CompletedDays="_completedDays" OnDaySelected="PlayDay" />

    <button type="button" class="previous-button" aria-expanded="@(_showMonth ? "true" : "false")"
            @onclick="ToggleMonth">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M3 10h18M8 3v4M16 3v4" />
        </svg>
        @(_showMonth ? "Hide previous games" : "Previous games")
    </button>
</section>

@if (_showMonth)
{
    <section class="card month-card" aria-label="Previous games">
        <MonthCalendar Today="_today" CompletedDays="_completedDays" OnDaySelected="PlayDay" />
    </section>
}

@code {

    private readonly DateOnly _today = LevelDate.Today;

    // Days whose finish line the player has reached, from progress saved on this device.
    private IReadOnlySet<DateOnly> _completedDays = new HashSet<DateOnly>();
    private bool _todayDone;
    private int _streak;

    private bool _showMonth;

    protected override void OnInitialized()
    {
        ShowProgress();
        Store.Changed += OnProgressChanged;
    }

    public void Dispose() => Store.Changed -= OnProgressChanged;

    private void OnProgressChanged()
    {
        ShowProgress();
        StateHasChanged();
    }

    private void ShowProgress()
    {
        var progress = Store.Progress;
        _completedDays = progress.FinishedDays;
        _todayDone = progress[_today].Finished;
        _streak = progress.CurrentStreak(_today);
    }

    private void ToggleMonth()
    {
        _showMonth = !_showMonth;
    }

    // Opens that day's level on the Home page. Today's level gets the plain link, like the Play button.
    private void PlayDay(DateOnly day)
    {
        Navigation.NavigateTo(day == _today ? "" : $"?date={LevelDate.ToText(day)}");
    }
}