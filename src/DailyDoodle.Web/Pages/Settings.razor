@page "/settings"
@using System.Linq
@using DailyDoodle.Core.LevelGeneration
@inject DailyDoodle.Web.Services.ProgressStore ProgressStore
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Profile &amp; Settings</PageTitle>

<h1 class="visually-hidden">Profile &amp; Settings</h1>

<section class="card profile-card" aria-label="Local player profile">
    <div class="avatar" aria-hidden="true" style="font-size: 2.5rem;">
        @(_avatar switch
        {
            "rocket" => "🚀",
            "frog" => "🐸",
            "bear" => "🐻",
            "elephant" => "🐘",
            "car" => "🚗",
            "balloon" => "🎈",
            _ => "⭐"
        })
    </div>

    <div class="profile-text" style="flex: 1; min-width: 0;">
        <div class="name">@_nickname</div>
        <div class="handle">Playing on this device</div>

        @if (_editingProfile)
        {
            <div style="display: grid; gap: 0.5rem; margin-top: 0.75rem;">
                <label for="player-nickname">Nickname</label>
                <input id="player-nickname"
                       @bind="_nicknameInput"
                       maxlength="20"
                       autocomplete="off"
                       style="width: 100%; min-width: 0;" />

                <label for="player-avatar">Avatar</label>
                <select id="player-avatar" @bind="_avatarInput">
                    <option value="star">⭐ Star</option>
                    <option value="rocket">🚀 Rocket</option>
                    <option value="frog">🐸 Frog</option>
                    <option value="bear">🐻 Bear</option>
                    <option value="elephant">🐘 Elephant</option>
                    <option value="car">🚗 Car</option>
                    <option value="balloon">🎈 Balloon</option>
                </select>
            </div>
        }

        <p role="status">@_profileMessage</p>

        <div style="display: flex; justify-content: flex-end; margin-top: 0.75rem;">
            @if (_editingProfile)
            {
                <button type="button"
                        class="sketch-button"
                        disabled="@(!_profileReady)"
                        @onclick="SaveProfile">
                    Save profile
                </button>
            }
            else
            {
                <button type="button"
                        class="sketch-button"
                        disabled="@(!_profileReady)"
                        @onclick="() => _editingProfile = true">
                    Edit
                </button>
            }
        </div>
    </div>
</section>

<h2 class="section-label">Your progress</h2>
<div class="card group">
    <SettingRow Title="Current streak"
                Value="@(ProgressStore.Progress.CurrentStreak(LevelDate.Today).ToString() + " days")" />
    <SettingRow Title="Levels completed"
                Value="@ProgressStore.Progress.FinishedDays.Count.ToString()" />
    <SettingRow Title="Best height"
                Value="@(ProgressStore.Progress.Days.Values.Select(day => day.BestHeight).DefaultIfEmpty(0f).Max().ToString("0"))" />
</div>
<h2 class="section-label">Account</h2>
<div class="card group">
    <SettingRow Title="Account" Description="Sign-in isn't available yet.">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
        </Icon>
    </SettingRow>
</div>

<h2 class="section-label">Preferences</h2>
<div class="card group">
    <SettingRow Title="Notifications" Value="Not available yet">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
        </Icon>
    </SettingRow>
    <div class="appearance-control">
        <SettingRow Title="Appearance" Value="@(_isDark ? "Dark" : "Light")">
            <Icon>
                <svg class="icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                </svg>
            </Icon>
        </SettingRow>
        <button type="button"
                class="sketch-button"
                disabled="@(!_themeReady)"
                aria-pressed="@(_isDark ? "true" : "false")"
                @onclick="ToggleTheme">
            Dark mode: @(_isDark ? "On" : "Off")
        </button>
    </div>

    <SettingRow Title="Sound &amp; Haptics" Value="Not available yet">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24">
                <path d="M11 5 6 9H2v6h4l5 4z" />
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14" />
            </svg>
        </Icon>
    </SettingRow>

    <SettingRow Title="Saved data"
                Description="Progress stays in this browser. Clearing this site's data removes your save.">
        <Icon>
            <svg class="icon" viewBox="0 0 24 24">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </Icon>
    </SettingRow>
@code {
    private bool _isDark;
    private bool _themeReady;
    private bool _profileReady;
    private bool _editingProfile;
    private string _nickname = "Player";
    private string _nicknameInput = "Player";
    private string _avatar = "star";
    private string _avatarInput = "star";
    private string _profileMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isDark = await JS.InvokeAsync<bool>("dailyDoodleTheme.get");
        _themeReady = true;

        try
        {
            var profile = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "dailyDoodleProfile.load");

            _nickname = profile.GetProperty("nickname").GetString() ?? "Player";
            _avatar = profile.GetProperty("avatar").GetString() ?? "star";
            _nicknameInput = _nickname;
            _avatarInput = _avatar;
            _profileReady = true;
        }
        catch (JSException)
        {
            _profileMessage = "Profile could not load. Refresh the page to try again.";
        }

        StateHasChanged();
    }

    private async Task SaveProfile()
    {
        var nickname = _nicknameInput.Trim();

        if (nickname.Length == 0 || nickname.Length > 20)
        {
            _profileMessage = "Enter a nickname between 1 and 20 characters.";
            return;
        }

        string[] allowedAvatars =
        [
            "star", "rocket", "frog", "bear",
            "elephant", "car", "balloon"
        ];

        if (!allowedAvatars.Contains(_avatarInput))
        {
            _profileMessage = "Choose an avatar from the list.";
            return;
        }

        try
        {
            var saved = await JS.InvokeAsync<bool>(
                "dailyDoodleProfile.save", nickname, _avatarInput);

            if (!saved)
            {
                _profileMessage = "Could not save. Browser storage may be unavailable.";
                return;
            }

            _nickname = nickname;
            _nicknameInput = nickname;
            _avatar = _avatarInput;
            _profileMessage = "Profile saved on this browser.";
            _editingProfile = false;
        }
        catch (JSException)
        {
            _profileMessage = "Could not save your profile. Please refresh and try again.";
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("dailyDoodleTheme.set", _isDark);
    }
}
}
</div>
